---
interface Props {
  title: string;
  description: string;
  /** 文章頁傳入 article 型別 */
  type?: 'website' | 'article';
}
const { title, description, type = 'website' } = Astro.props;
const siteName = '阿光的紫微斗數筆記';
const fullTitle = title === siteName ? siteName : `${title}｜${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/hero.jpg', Astro.site)} />
    <meta name="theme-color" content="#0f0b1e" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">✦</span>
        <span class="brand-name">{siteName}</span>
      </a>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        首頁圖片：<a href="https://commons.wikimedia.org/wiki/File:A_Mix_of_Colours_and_Wonder.jpg" rel="noopener" target="_blank">A Mix of Colours and Wonder</a>，
        作者 <a href="https://www.eso.org/public/images/potw1524a/" rel="noopener" target="_blank">ESO/B. Tafreshi (twanight.org)</a>，
        以 <a href="https://creativecommons.org/licenses/by/4.0/deed.zh_TW" rel="license noopener" target="_blank">CC BY 4.0</a> 授權使用。
      </p>
      <p>© {new Date().getFullYear()} 阿光（ひかる）・{siteName}</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0f0b1e;
    --bg-elev: #1a1430;
    --bg-card: #1f1838;
    --border: #372c5c;
    --text: #ebe6f7;
    --text-muted: #a99fc4;
    --accent: #c7a4ff;
    --accent-strong: #e2ccff;
    --link: #b8a0f0;
    --max: 44rem;
    --font: 'Noto Sans TC', 'PingFang TC', 'Microsoft JhengHei', 'Helvetica Neue', Arial, system-ui, sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: var(--font);
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--text);
    background:
      radial-gradient(60rem 30rem at 20% -10%, #2a1d52 0%, transparent 60%),
      radial-gradient(40rem 20rem at 100% 0%, #1c3a5c33 0%, transparent 60%),
      var(--bg);
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  /* 防止長字串、長網址撐破版面 */
  body,
  p,
  li,
  h1,
  h2,
  h3,
  h4,
  a,
  td,
  th {
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  img,
  video,
  svg {
    max-width: 100%;
    height: auto;
    display: block;
  }

  a {
    color: var(--link);
    text-decoration: none;
    text-underline-offset: 0.2em;
  }
  a:hover {
    color: var(--accent-strong);
    text-decoration: underline;
  }

  h1,
  h2,
  h3,
  h4 {
    line-height: 1.35;
    letter-spacing: 0.01em;
    color: var(--accent-strong);
    margin: 2em 0 0.6em;
  }
  h1 {
    font-size: clamp(1.7rem, 2.2vw + 1.2rem, 2.4rem);
  }
  h2 {
    font-size: clamp(1.3rem, 1vw + 1.05rem, 1.6rem);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.3em;
  }
  h3 {
    font-size: 1.2rem;
  }

  p {
    margin: 0 0 1.2em;
  }

  ul,
  ol {
    padding-left: 1.4em;
  }

  blockquote {
    margin: 1.4em 0;
    padding: 0.6em 1em;
    border-left: 3px solid var(--accent);
    background: var(--bg-elev);
    color: var(--text-muted);
    border-radius: 0 0.5rem 0.5rem 0;
  }
  blockquote p:last-child {
    margin-bottom: 0;
  }

  code {
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 0.92em;
    background: var(--bg-elev);
    padding: 0.1em 0.4em;
    border-radius: 0.3em;
  }
  pre {
    overflow-x: auto;
    padding: 1em;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 0.6rem;
  }
  pre code {
    background: none;
    padding: 0;
  }

  /* 表格在手機上可橫向捲動，不撐破頁面 */
  .prose table {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 1.4em 0;
    font-size: 0.95em;
  }
  .prose th,
  .prose td {
    border: 1px solid var(--border);
    padding: 0.5em 0.8em;
    text-align: left;
    white-space: nowrap;
  }
  .prose th {
    background: var(--bg-elev);
    color: var(--accent-strong);
  }

  hr {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 2.5em 0;
  }

  /* 版面骨架 */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(10px);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    border-bottom: 1px solid var(--border);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    max-width: var(--max);
    margin: 0 auto;
    padding: 0.8rem 1rem;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--accent-strong);
  }
  .brand:hover {
    text-decoration: none;
  }
  .brand-mark {
    color: var(--accent);
  }

  .site-main {
    flex: 1;
    width: 100%;
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 1rem 3rem;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.7;
  }
  .site-footer p {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0.5rem 1rem;
  }
  .site-footer p:first-child {
    padding-top: 1.2rem;
  }
  .site-footer p:last-child {
    padding-bottom: 1.5rem;
  }

  /* 共用小元件 */
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    color: var(--text-muted);
    font-size: 0.88rem;
  }
  .meta time,
  .meta span {
    white-space: nowrap;
  }
  .views::before {
    content: '👁 ';
  }
</style>
